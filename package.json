{
	"name": "@juvofy/lib",
	"version": "1.3.0",
	"type": "module",
	"license": "MIT",
	"scripts": {
		"dev": "npm run docs:utils && storybook dev -p 6006",
		"build": "npm run docs:utils && storybook build",
		"preview": "vite preview --outDir storybook-static",
		"postinstall": "svelte-package -i src",
		"format": "prettier --write .",
		"storybook": "npm run docs:utils && storybook dev -p 6006",
		"build-storybook": "npm run docs:utils && storybook build",
		"docs:utils": "node scripts/generate-utils-docs.mjs",
		"check": "svelte-check --tsconfig tsconfig.json && tsc --noEmit && oxlint && prettier --check ."
	},
	"devDependencies": {
		"@storybook/addon-docs": "10.6.0",
		"@storybook/addon-svelte-csf": "^5.1.3",
		"@storybook/svelte-vite": "^10.6.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^26.6.1",
		"oxlint": "^1.83.0",
		"prettier-plugin-svelte": "^4.1.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"storybook": "^10.6.0",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"typescript": "~6.0.3",
		"typescript-classic": "npm:typescript@^5.9.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@material-symbols/svg-400": "^0.47.3",
		"@stanko/dual-range-input": "^1.0.1",
		"@sveltejs/package": "^2.5.8",
		"@types/common-tags": "^1.8.4",
		"cally": "^0.9.2",
		"common-tags": "^1.8.2",
		"daisyui": "^5.7.39",
		"emoji-picker": "^0.0.7",
		"emoji-picker-element-data": "^1.8.0",
		"fast-xml-parser": "^5.11.1",
		"shiki": "^4.4.3",
		"svelte": "^5.57.0",
		"tailwindcss": "^4.3.3"
	},
	"exports": {
		".": {
			"types": "./dist/main.d.ts",
			"import": "./dist/main.js",
			"svelte": "./dist/main.js"
		},
		"./components/*": {
			"types": "./dist/components/*.svelte.d.ts",
			"import": "./dist/components/*.svelte",
			"svelte": "./dist/components/*.svelte"
		},
		"./utils/*": {
			"types": "./dist/utils/*.d.ts",
			"import": "./dist/utils/*.js",
			"svelte": "./dist/utils/*.js"
		},
		"./vite/*": {
			"types": "./dist/vite/*.d.ts",
			"import": "./dist/vite/*.js",
			"svelte": "./dist/vite/*.js"
		},
		"./app.tw.css": "./dist/app.tw.css",
		"./App": {
			"types": "./dist/App.svelte.d.ts",
			"import": "./dist/App.svelte",
			"svelte": "./dist/App.svelte"
		}
	},
	"peerDependencies": {
		"vite": "^8.0.14"
	}
}
